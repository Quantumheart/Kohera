default_platform(:ios)

# ── App Store Connect API key (reuse release.yml secrets) ──────
def connect_api_key
  app_store_connect_api_key(
    key_id:       ENV["APPSTORE_CONNECT_KEY_ID"],
    issuer_id:    ENV["APPSTORE_CONNECT_ISSUER_ID"],
    key_filepath: ENV["APPSTORE_CONNECT_KEY_FILEPATH"],
    duration:     1200,
    in_house:     false
  )
end

# ── CI: pull cert + profiles, never mutate ──────────────────────
lane :sync_signing do
  match(
    type: "appstore",
    readonly: true,
    api_key: connect_api_key
  )
end

# ── Local: generate/refresh cert + profiles into the store ──────
lane :provision do
  match(
    type: "appstore",
    api_key: connect_api_key
  )
end